<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.passwordmanager.controller.LoginController"
      alignment="CENTER"
      spacing="20"
      styleClass="login-container">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Title -->
    <Label text="Password Manager" styleClass="title">
        <font>
            <Font name="System Bold" size="24"/>
        </font>
    </Label>

    <Label text="Secure Your Passwords" styleClass="subtitle">
        <font>
            <Font size="14"/>
        </font>
    </Label>

    <!-- Master Password Input -->
    <VBox spacing="10" alignment="CENTER">
        <Label text="Master Password:" styleClass="field-label"/>
        
        <PasswordField fx:id="masterPasswordField" 
                      promptText="Enter master password" 
                      styleClass="password-field"
                      prefWidth="280"/>
        
        <TextField fx:id="masterPasswordVisibleField"
                  promptText="Enter master password"
                  styleClass="password-field"
                  prefWidth="280"/>
        
        <CheckBox fx:id="showPasswordCheckBox" text="Show password"/>
    </VBox>

    <!-- Error Label -->
    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="280"/>

    <!-- Buttons -->
    <VBox spacing="10" alignment="CENTER">
        <Button fx:id="loginButton" 
                text="Login" 
                onAction="#handleLogin"
                styleClass="primary-button"
                prefWidth="280"/>
        
        <Button fx:id="createVaultButton" 
                text="Create New Vault" 
                onAction="#handleCreateVault"
                styleClass="primary-button"
                prefWidth="280"/>
    </VBox>

    <Label text="Minimum 8 characters required" styleClass="hint-label">
        <font>
            <Font size="11"/>
        </font>
    </Label>

</VBox>
