<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.passwordmanager.controller.MainController"
            styleClass="main-container">

    <!-- Menu Bar -->
    <top>
        <VBox>
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Exit" onAction="#handleExit"/>
                </Menu>
                <Menu text="Help">
                    <MenuItem text="About" onAction="#handleAbout"/>
                </Menu>
            </MenuBar>

            <!-- Toolbar -->
            <ToolBar styleClass="toolbar">
                <Button text="Add Entry" 
                        onAction="#handleAddEntry"
                        styleClass="primary-button"/>
                <Button text="Generate Password" 
                        onAction="#handleGeneratePassword"
                        styleClass="secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Search:"/>
                <TextField fx:id="searchField" 
                          promptText="Search entries..."
                          prefWidth="200"/>
            </ToolBar>
        </VBox>
    </top>

    <!-- Center: Password Table -->
    <center>
        <TableView fx:id="passwordTable" styleClass="password-table">
            <columns>
                <TableColumn fx:id="websiteColumn" 
                            text="Website" 
                            prefWidth="200"
                            minWidth="150"/>
                <TableColumn fx:id="usernameColumn" 
                            text="Username" 
                            prefWidth="200"
                            minWidth="150"/>
                <TableColumn fx:id="passwordColumn" 
                            text="Password" 
                            prefWidth="150"
                            minWidth="100"
                            editable="false"/>
                <TableColumn fx:id="actionsColumn" 
                            text="Actions" 
                            prefWidth="250"
                            minWidth="200"
                            sortable="false"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- Bottom: Status Bar -->
    <bottom>
        <HBox styleClass="status-bar" spacing="10">
            <padding>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </padding>
            <Label fx:id="statusLabel" text="Ready"/>
        </HBox>
    </bottom>

</BorderPane>
